datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  // обратные стороны M2M
  casinos  Casino[]  @relation("CasinoCategories")
  articles Article[] @relation("ArticleCategories")

  createdAt DateTime @default(now())
}

model Casino {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  rating     Int?
  license    String?
  minDeposit Int?
  is18plus   Boolean  @default(true)
  logoUrl    String?
  shortDesc  String?
  pros       String[] // text[] в Postgres
  cons       String[] // text[] в Postgres

  links AffiliateLink[]
  bonuses Bonus[]

  // M2M с категориями (обе стороны должны быть)
  categories Category[] @relation("CasinoCategories")

  // обратная сторона для Click.casino
  clicks Click[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffiliateLink {
  id          String  @id @default(cuid())
  casinoId    String
  network     String
  baseUrl     String
  subTemplate String?
  isPrimary   Boolean @default(true)

  casino Casino @relation(fields: [casinoId], references: [id], onDelete: Cascade)

  // обратная сторона для Click.link
  clicks Click[]
}

model Bonus {
  id          String  @id @default(cuid())
  casinoId    String

  name        String
  bonusUrl    String?
  promocode   String?

  casino Casino @relation(fields: [casinoId], references: [id], onDelete: Cascade)
}

model Article {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  bodyMd    String
  published Boolean @default(false)

  // M2M с категориями (обе стороны должны быть)
  categories Category[] @relation("ArticleCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Click {
  id        String   @id
  casinoId  String
  linkId    String
  source    String?
  gclid     String?
  gbraid    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  casino Casino        @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  link   AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
}


// Партнерская система
model AffiliateUser {
  id           String    @id @default(cuid())
  username     String?
  avatar       String    @default("0.png") // храним имя файла 0.png - 9.png
  referralCode String    @unique
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  
  referrals    Referral[]
}

// Остальные модели (Referral, AffiliateClick) остаются как были в прошлом ответе


model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referredIp      String   // IP того, кого привели
  referredCountry String?  // Страна (FR, etc)
  createdAt       DateTime @default(now())
  confirmed       Boolean  @default(false) // Становится true при клике на партнерку
  
  referrer        AffiliateUser @relation(fields: [referrerId], references: [id])
}

model AffiliateClick {
  id             String   @id @default(cuid())
  referralCode   String
  ip             String
  country        String?
  userAgent      String?
  isPartnerClick Boolean  @default(false) // true если клик по кнопке "Играть", false если просто заход
  createdAt      DateTime @default(now())
}